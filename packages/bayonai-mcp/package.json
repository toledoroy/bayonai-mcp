{
  "name": "@bayonai/mcp",
  "version": "1.0.14",
  "description": "Shared MCP OAuth and protocol helpers for Bayon apps.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oauth",
    "pkce",
    "bayon"
  ],
  "homepage": "https://github.com/toledoroy/bayonai-mcp#readme",
  "bugs": {
    "url": "https://github.com/toledoroy/bayonai-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toledoroy/bayonai-mcp.git",
    "directory": "packages/bayonai-mcp"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/prepare-dist.mjs",
    "lint": "tsc --noEmit -p tsconfig.cjs.json && tsc --noEmit -p tsconfig.esm.json",
    "prepack": "pnpm run build",
    "smoke:pack": "node scripts/smoke-package.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
